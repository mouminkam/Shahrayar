# Frontend-only build — there is no backend behind this app.
#
# Every endpoint resolves from src/mocks/fixtures/* through src/mocks/mockClient.ts,
# so none of the variables below are needed to run it:
#   npm install && npm run dev
#
# They document what a real backend integration expects — src/api/config/axios.ts
# and src/api/config/serverAxios.ts show exactly how each one is consumed, and
# every function in src/api/*.ts has a commented "PRODUCTION:" line showing the
# real network call it currently stands in for.

# Public origin used for canonical URLs, sitemap.xml and OpenGraph tags.
# Falls back to http://localhost:3000 if unset (see src/data/constants.ts).
# NEXT_PUBLIC_SITE_URL=https://your-portfolio-domain

# Base URL of the real backend API, once one exists.
# NEXT_PUBLIC_API_BASE_URL=https://<api-host>/api/v1

# Stripe publishable key — only the publishable (client-safe) key belongs here.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google OAuth (Sign in with Google), used by src/store/authStore.ts.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>
# NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
